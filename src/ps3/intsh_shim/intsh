#pragma once
// PSL1GHT's ppu-types.h (u8/u16/u32/u64/s8/s16/s32/s64) goes in here, not in
// intsh.hpp -- see that file's doc comment, and src/ps2/intsh_shim/intsh for
// the same arrangement against ps2sdk's tamtypes.h. Every engine header's own
// `#include <intsh>` is the one thing guaranteed to run before it uses any of
// those names, on every platform including this one, so piggybacking on that
// include is more robust than trying to force ppu-types.h in some other way
// (e.g. a compiler -include flag, whose ordering against the demo target's
// own -include <charmaps.hpp> is not guaranteed).
#include <ppu-types.h>
#include "intsh.hpp"
