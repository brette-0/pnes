# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# Per-developer CMake overrides (see local.cmake.example)
local.cmake
CMakeUserPresets.json

# Per-developer Docker Compose env (UID/GID for build-output ownership).
# Must stay out of CI's checkout so the services fall back to the 0:0 default.
.env

# CMake build trees. Releases are produced by GitHub Actions;
# local build directories should never be committed. Non-CI local builds
# live under builds/ (see CMakePresets.json); CI builds still build in the
# repo root as cmake-build-ci-*/.
builds/
cmake-build-*/
build/
build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
Testing/

# Sphinx/Doxygen build artifacts
docs/_build/
docs/doxygen-api/
docs/doxygen-advanced/

# Cloudflare Pages deploy staging (CI regenerates it from the web build) and
# wrangler's local OAuth/cache state. Neither belongs in the repo.
dist/
.wrangler/

# Scratch/local-only notes (investigation write-ups, etc.) that shouldn't be committed.
.ignore/

# uitk-generated UI code (demo/ui/*.uis -> demo/gen/...) -- regenerated by
# CMake before the demo target builds (see CMakeLists.txt's uitk-export
# step), never hand-edited, so it doesn't belong in the repo.
demo/gen/
