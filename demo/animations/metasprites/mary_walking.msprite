# pnes animator metasprite -- see the .anim beside this folder

[metasprite]
name   = "mary_walking"
palette = "player"    # a [[palette]] in the .anim; empty for the placeholder colours
width  = 2    # in tiles; a tile is 8x8 or 8x16 by the project's tile_mode
height = 1

[[frame]]
name  = "frame_1"
timer = 8
public = true    # name this frame's bytes in the generated header
sprites = [
    { col = 0, row = 0, id = 0x08, pattern = 0x09, entry = "normalSprites", include = "player_walking1", tile = 0, flip_h = false, flip_v = false },
    { col = 1, row = 0, id = 0x0a, pattern = 0x0b, entry = "normalSprites", include = "player_walking1", tile = 2, flip_h = false, flip_v = false },
]

[[frame]]
name  = "frame_2"
timer = 8
public = true    # name this frame's bytes in the generated header
sprites = [
    { col = 0, row = 0, id = 0x0c, pattern = 0x0d, entry = "normalSprites", include = "player_walking2", tile = 0, flip_h = false, flip_v = false },
    { col = 1, row = 0, id = 0x0e, pattern = 0x0f, entry = "normalSprites", include = "player_walking2", tile = 2, flip_h = false, flip_v = false },
]

[[frame]]
name  = "frame_3"
timer = 8
public = true    # name this frame's bytes in the generated header
sprites = [
    { col = 0, row = 0, id = 0x10, pattern = 0x11, entry = "normalSprites", include = "player_walking3", tile = 0, flip_h = false, flip_v = false },
    { col = 1, row = 0, id = 0x12, pattern = 0x13, entry = "normalSprites", include = "player_walking3", tile = 2, flip_h = false, flip_v = false },
]
