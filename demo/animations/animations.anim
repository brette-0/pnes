# pnes animator project

[project]
# The blobman manifest the tiles come from, relative to this file.
chr         = "../chr/config.toml"
# Sidecar folder holding the .msprite manifests, relative to this file.
metasprites = "metasprites"
# How tiles were grouped when this was authored: "8x8" or "8x16".
# One tile slot of a metasprite is 8x8 or 8x16 accordingly.
tile_mode   = "8x16"
# The metasprites of this project, in order. Each names a file in
# the folder above.
files       = [
    "mary_standing.msprite",
    "mary_walking.msprite",
]

[[palette]]
name    = "player"
colours = [ 0x07, 0x26, 0x03 ]    # NES master-palette indices for colours 1-3

[[frame]]
# The tile-id space (0x00-0xff) sprites of this project draw from.
# The windows are equally sized -- 256 / however many there are --
# and their ORDER is what gives a tile its id. An empty name
# reserves a window's ids for whatever else the game banks there.
name          = "sprites"
pattern_table = 0x1000    # 0x0000 or 0x1000; bit 0 of an 8x16 pattern byte
windows       = [
    "normalSprites",
    "",
]
