# Per-developer CMake overrides.
#
# Copy this file to local.cmake and edit the values for your machine.
# local.cmake is gitignored, so these settings stay on your machine.
#
# CMakeLists.txt includes local.cmake automatically if it exists.

# Application / SDL3 window title. Compiled in as the PROJECT_NAME define and
# used to name the SDL3 window. Optional -- CMakeLists.txt falls back to a
# default if this is left unset.
set(PROJECT_NAME "My Super Game")

# Nametable mirroring orientation: LANDSCAPE or PORTRAIT. Optional --
# CMakeLists.txt falls back to LANDSCAPE if this is left unset.
set(ORIENTATION "LANDSCAPE")

# Path to your llvm-mos-sdk install root, used by the NES build. Only required
# if you build the NES target. CMakeLists derives the cross-toolchain and
# CMAKE_PREFIX_PATH from this one value. The SDK does NOT need to be on your
# PATH -- in fact keep it off PATH, so a bare clang/clang++ resolves to your
# host system compiler for the desktop (linux/mac/win) builds rather than the
# 6502 cross-compiler.
set(LLVM_MOS_SDK "C:/llvm-mos" CACHE PATH "" FORCE)

# Path to your cc65 install (the directory that contains bin/ca65). Used by
# the NES build to assemble the FamiStudio sound engine. Only required if
# ca65 is not already on PATH.
set(CC65_DIR "C:/cc65" CACHE PATH "" FORCE)

# Alternative nametable wiring (NES2.0 flags 6, bit 3 -- the "four-screen"
# bit): set this if your board supplies its own nametable memory/routing
# instead of the console's default 2-way CIRAM mirror (e.g. a TVROM-style
# board with an extra VRAM chip). Any non-zero value works -- only its
# non-zero-ness reaches the header; the number itself is not a hardware
# quantity. Optional -- CMakeLists.txt leaves the bit clear if left unset.
# set(ALTERNATIVE_NAMETABLE 1)

# Path to your project's own top-level linker script for the NES/MMC3 build.
# Only required if you build the NES target. The library never supplies this
# itself -- only a helper (src/nes/mappers/mmc3-helper.ld) with the
# hardware/mechanical facts, which your own script should INCLUDE. demo/link.ld
# is this repo's own reference example (ROM size, and this repo's own
# MMC3_BANKED()-tagged domains) -- copy its shape for your own project rather
# than pointing straight at it, once you have real domains of your own to
# declare.
set(TOPLEVEL_LD "${CMAKE_SOURCE_DIR}/demo/link.ld" CACHE FILEPATH "" FORCE)

# ELF section the platform-nes audio module (src/nes/audio.cpp) is placed
# into. MUST name the same PRG-ROM bank the audio engine is assembled into --
# demo/famistudio_config.s's FAMISTUDIO_CA65_CODE_SEGMENT is the ca65 side of
# the same decision. Side by side, audio.cpp calls the engine directly and
# does no bank switching; the caller long-calls audio::Update() and both come
# in together. Compulsory: there is no default, because a guessed bank is a
# crash with no diagnostic.
set(PLATFORM_NES_AUDIO_SECTION ".prg_rom_audio" CACHE STRING "" FORCE)

# ELF section the UI toolkit (src/all/extras/ui/*.cpp) is placed into.
# Compulsory, like audio's above -- there is no default, because a guessed
# section would place this module wherever the library guessed with no
# diagnostic. Unlike audio, there's no external engine it must share a bank
# with, so this doesn't need a dedicated bank of its own -- co-locating it
# with an existing one (here, the demo's own prg_rom_cold, reached via
# ::COLD) is a valid choice as long as that bank has room. Your linker
# script must route the name into a MEMORY region, and the section must be
# reachable from wherever UI code is called.
set(PLATFORM_NES_UI_SECTION ".prg_rom_cold" CACHE STRING "" FORCE)

# ELF sections uitk-generated UI code/data is placed into, plus any other
# CREATE_SEGMENT_KEYWORD-built placement macro your own banks.hpp hands out.
# These are DEMO-owned, unlike AUDIO/UI_SECTION above (a library concern) --
# your own scenes' Linker/BSS/Data Prefix fields in uitk name these macros
# directly, so they're deliberately bare (TITLE/SYSMEM, no
# PLATFORM_NES_/_SECTION dressing) rather than namespaced: whatever you type
# into uitk's prefix fields is exactly the CMake variable you set here.
#
# That bareness is a real tradeoff, not a free lunch -- an object-like macro
# this generic can collide with an unrelated declaration that happens to
# share the name. In particular, avoid all-lowercase names that shadow a
# standard library identifier: e.g. "system" collides with the
# int system(const char*) declared in <stdlib.h>/<cstdlib> (reachable here
# via mos-platform/common/include/stdlib.h, common to every mos-platform
# target including NES) -- any TU that includes it after this macro is
# defined fails to compile. ALL_CAPS, as used throughout this project's own
# placement macros (COLD, TITLE, ACTORS, AUDIO_BANK, UI_BANK -- see
# demo/src/banks.hpp), sidesteps this: nothing in the standard library or
# this SDK is spelled in all caps.
#
# Compulsory, same as AUDIO/UI_SECTION above -- CMakeLists.txt FATAL_ERRORs
# if either is unset rather than guessing a bank. TITLE_DATA is NOT its own
# variable: it's always TITLE's own value with ".rodata" appended (same
# relationship demo/src/banks.hpp used to hand-write locally), so there's
# only ever one placement decision per macro to keep in sync, not two.
set(TITLE ".prg_rom_cold" CACHE STRING "" FORCE)
# Mirrors mmc3.hpp's own ::SYSMEM (".sysmem", onboard system RAM, NOLOAD --
# see mmc3-helper.ld's `.sysmem (NOLOAD) : { *(.sysmem .sysmem.*) } >ram`).
# Generated code can't #include the MMC3 mapper header just to get that
# macro (it isn't NES-mapper-specific and shouldn't couple to one), so it's
# fed in from here instead, same as TITLE.
set(SYSMEM ".sysmem" CACHE STRING "" FORCE)

# ELF section the video module (src/nes/video.cpp) is placed into. OPTIONAL and
# unset by default, unlike audio's: leave it out and video is inlined into its
# callers, which is both smaller overall and what LTO does anyway.
#
# Setting it moves video's out-of-line code into the named section and gives up
# that inlining. Your linker script must define a MEMORY region and rule for the
# name, and the section must be reachable from wherever video is called --
# nothing checks that, and a wrong answer is a crash with no diagnostic.
#
# The functions an interrupt handler can reach are pinned inline regardless and
# never move; see src/nes/video.cpp.
#
# set(PLATFORM_NES_VIDEO_SECTION ".prg_rom_video" CACHE STRING "" FORCE)
