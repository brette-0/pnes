# Native Nintendo Wii U (devkitPPC / wut / SDL2 portlib) build image for
# pnes.
#
# Built on devkitPro's official devkitPPC image -- the same base the libogc/GX
# (GameCube/Wii) image uses, since the Wii U's Espresso is a PowerPC 750 -- but
# this target is the NATIVE Cafe OS path (wut), NOT vWii/libogc. It adds wut (the
# Wii U toolchain + elf2rpl/wuhbtool packaging tools) and the SDL2 Wii U portlib
# the src/wiiu backend builds against:
#
#   docker compose run --rm build-wiiu     # native Wii U demo.rpx / demo.wuhb
#
# The same image backs CI and local runs, and `act -j wiiu` reuses it.
FROM devkitpro/devkitppc:latest

ENV DEBIAN_FRONTEND=noninteractive

# Install the native Wii U toolchain (wut + the .rpx/.wuhb packaging tools, the
# WiiU.cmake / Platform/CafeOS.cmake integration) and the SDL2 portlib (which
# pulls in its GX2/coreinit/VPAD portlib deps). --needed makes this a no-op for
# anything the base image already ships.
RUN dkp-pacman -S --needed --noconfirm wiiu-dev wiiu-sdl2

# The base image is Ubuntu-based; add the host-side build tools the project
# needs that aren't part of the devkit toolchain itself. (Ninja is the preset
# generator; git/wget/ca-certificates support FetchContent of intsh/tuple/stb;
# ffmpeg re-encodes the audio track to a Vorbis OGG that gets #embedded into the
# .rpx at build time -- see the wiiu branch in CMakeLists.txt.)
#
# The last two support the optional installable-WUP path (the homebrew .rpx /
# .wuhb need neither): imagemagick converts demo/demo.png into the uncompressed
# TGAs the Wii U menu wants (iconTex/bootTvTex/bootDrcTex), and the JRE runs
# NUSPacker.jar to encrypt the code/content/meta tree into an installable title.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ninja-build \
        git \
        wget \
        ca-certificates \
        xz-utils \
        file \
        ffmpeg \
        imagemagick \
        default-jre-headless \
    && rm -rf /var/lib/apt/lists/*

# NUSPacker (ihaveamac/nuspacker) packs the unpacked code/content/meta tree into
# an installable WUP, encrypting the contents with the Wii U common key. It is a
# self-contained jar with no releases, so pin the known-good prebuilt artifact
# from the repo. The common key itself is NOT baked in -- it is passed at build
# time via WIIU_COMMON_KEY (a CI secret / local cache var), never committed.
RUN mkdir -p /opt/nuspacker \
    && wget -qO /opt/nuspacker/NUSPacker.jar \
        https://raw.githubusercontent.com/ihaveamac/nuspacker/master/NUSPacker.jar
ENV WIIU_NUSPACKER_JAR=/opt/nuspacker/NUSPacker.jar

# The intsh/tuple dependencies declare a CMake 4.2 floor (and CMakePresets.json
# needs 3.21+); the devkit image's bundled CMake can lag behind. Install
# Kitware's official binary, pinned to match the other target images so every
# target stays in lockstep. The symlinks go in /usr/local/bin, ahead of the
# devkit-provided cmake on PATH.
ARG CMAKE_VERSION=4.3.3
RUN wget -qO- https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-x86_64.tar.gz \
        | tar -xz -C /opt \
    && ln -sf /opt/cmake-${CMAKE_VERSION}-linux-x86_64/bin/cmake /usr/local/bin/cmake \
    && ln -sf /opt/cmake-${CMAKE_VERSION}-linux-x86_64/bin/ctest /usr/local/bin/ctest \
    && ln -sf /opt/cmake-${CMAKE_VERSION}-linux-x86_64/bin/cpack /usr/local/bin/cpack

WORKDIR /src
