# PlayStation 2 (ps2sdk / EE+IOP) build image for platform-nes.
#
# Built on the official PS2DEV image (Alpine-based, not Debian like the other
# docker/Dockerfile.* here), which ships the prebuilt MIPS EE/IOP cross-toolchain
# (mips64r5900el-ps2-elf-gcc/g++, iop-gcc, ...) and ps2sdk, with PS2DEV, PS2SDK,
# GSKIT already exported and their bin/ dirs on PATH -- building that toolchain
# from source takes 30-60+ minutes, so this pulls the prebuilt one instead of
# running ps2dev/ps2dev's own build-all.sh.
#
# ps2-release/ps2-debug (CMakePresets.json, gated on PS2DEV being set -- it
# is, in this image) build the actual demo ELF via the ps2 branch of
# CMakeLists.txt:
#
#   docker compose run --rm build-ps2
FROM ps2dev/ps2dev:latest

# Alpine's own cmake package (4.2.3 as of writing) already clears the intsh/tuple
# floor (4.2) and CMakePresets.json's 3.21+ requirement, and -- unlike every
# other docker/Dockerfile.* here -- it's musl-native, so the Kitware glibc
# binary the other images pin can't run on this base at all. ninja is the
# preset generator; git/wget/ca-certificates support FetchContent of
# intsh/tuple; file lets a build-verify step sniff the produced ELF; ffmpeg
# transcodes demo/audio/tracks/pc_audio.wav into the music asset the ELF
# #embeds (same requirement as the PSP branch). Which asset depends on
# PS2_MUSIC: the default `stream` backend (src/ps2/audio_stream.cpp) has ffmpeg
# downmix to mono and then encodes SPU2 ADPCM with ps2sdk's own bin/adpenc,
# already on PATH in this image; `spu2` does the same with adpenc -L; only the
# `vorbis` reference backend (src/ps2/audio.cpp) needs the libvorbis encoder,
# which Alpine's ffmpeg build provides.
# bash is otherwise absent on this Alpine base (build-ps2 itself uses sh);
# it's needed here because IDE Docker toolchains (e.g. CLion) exec bash
# inside the container to run their compiler/build-tool auto-detection.
RUN apk add --no-cache \
        bash \
        cmake \
        ninja \
        git \
        wget \
        ca-certificates \
        xz \
        file \
        ffmpeg

WORKDIR /src
