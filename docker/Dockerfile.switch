# Nintendo Switch (libnx) build image for pnes.
#
# Built on devkitPro's official devkitA64 image, which ships the AArch64
# cross-toolchain (aarch64-none-elf-g++), the dkp-pacman package manager and the
# Switch CMake integration (Switch.cmake + NXTools.cmake), with DEVKITPRO and
# DEVKITA64 already exported. The switch-dev package group (libnx, the
# elf2nro/nacptool packaging tools) is installed below so the framebuffer/audout
# backend in src/switch builds against libnx:
#
#   docker compose run --rm build-switch   # Switch demo.nro
#
# The same image backs CI and local runs, and `act -j switch` reuses it.
FROM devkitpro/devkita64:latest

ENV DEBIAN_FRONTEND=noninteractive

# Ensure the full Switch toolchain + libraries are present (libnx and the
# .nro/.nacp packaging tools). --needed makes this a no-op if the base image
# already ships them.
RUN dkp-pacman -S --needed --noconfirm switch-dev

# The base image is Ubuntu-based; add the host-side build tools the project
# needs that aren't part of the devkit toolchain itself. (Ninja is the preset
# generator; git/wget/ca-certificates support FetchContent of intsh/tuple;
# ffmpeg re-encodes the audio track to raw 48k PCM for the RomFS at build time --
# see the switch branch in CMakeLists.txt.)
RUN apt-get update && apt-get install -y --no-install-recommends \
        ninja-build \
        git \
        wget \
        ca-certificates \
        xz-utils \
        file \
        ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# The intsh/tuple dependencies declare a CMake 4.2 floor (and CMakePresets.json
# needs 3.21+); the devkit image's bundled CMake can lag behind. Install
# Kitware's official binary, pinned to match the other target images so every
# target stays in lockstep. The symlinks go in /usr/local/bin, ahead of the
# devkit-provided cmake on PATH.
ARG CMAKE_VERSION=4.3.3
RUN wget -qO- https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-x86_64.tar.gz \
        | tar -xz -C /opt \
    && ln -sf /opt/cmake-${CMAKE_VERSION}-linux-x86_64/bin/cmake /usr/local/bin/cmake \
    && ln -sf /opt/cmake-${CMAKE_VERSION}-linux-x86_64/bin/ctest /usr/local/bin/ctest \
    && ln -sf /opt/cmake-${CMAKE_VERSION}-linux-x86_64/bin/cpack /usr/local/bin/cpack

WORKDIR /src
